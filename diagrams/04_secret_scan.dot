digraph g {
    graph [bgcolor="#0d1117", rankdir=LR, fontname="Helvetica", fontcolor="#e6edf3", labelloc="t", fontsize=20, label="Pre-mount secret scan", pad=0.3, nodesep=0.4, ranksep=0.6];
    node  [fontname="Helvetica", fontcolor="#e6edf3", color="#30363d", style="filled,rounded", shape=box, penwidth=2, margin="0.25,0.18", fillcolor="#161b22"];
    edge  [color="#8b949e", fontname="Helvetica", fontcolor="#adbac7", penwidth=1.6, arrowsize=0.9];

    p [label="3 candidate paths\n(Documents, Downloads, research_notes)", color="#58a6ff", fillcolor="#13294d"];
    a [label="filenames to depth 6\n.env, id_rsa, *.pem, .netrc ..."]; b [label="symlinks escaping the tree"];
    c [label="content patterns\nAKIA, sk-, ghp_, PRIVATE KEY, xox, hf_"];
    f1 [label="one real .env\n(API key present)", color="#f85149"]; f2 [label="AKIA hit = key ID inside an\nexpired pre-signed URL: benign", color="#3fb950"];
    f3 [label="one symlink out of the tree\n(nginx backup, points at /etc)", color="#d29922"];
    act [label="mask .env with /dev/null;\nrotate the key later", color="#bc8cff", style="filled,rounded,dashed"];
    p->a; p->b; p->c; a->f1; c->f2; b->f3; f1->act;
}